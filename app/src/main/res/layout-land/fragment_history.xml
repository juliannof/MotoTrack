<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Mapa oculto (la lista opaca lo tapa): solo sirve para sacar las capturas de las rutas -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/map_render"
        android:layout_width="360dp"
        android:layout_height="200dp"
        android:layout_gravity="top|start" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_routes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:padding="8dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="🏍️\nNo hay rutas grabadas aún.\nPulsa INICIAR RUTA para comenzar."
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:gravity="center"
        android:visibility="gone" />

</FrameLayout>
